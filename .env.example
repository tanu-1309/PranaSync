# copy to .env (never commit .env)
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/prana   # default: SQLite file data/prana.db

# ---- optional language model for Prana (see docs/LLM_SETUP.md). Off unless PRANA_LLM=1.
# Option A: any OpenAI-compatible service. Ollama on your own computer needs no key and sends nothing out:
# PRANA_LLM=1
# PRANA_LLM_URL=http://localhost:11434/v1
# PRANA_LLM_MODEL=llama3.2
# Option B: a hosted free tier (Groq, OpenRouter, Google Gemini): also set the key and use that provider's URL and model name
# PRANA_LLM_KEY=
# Option C: Anthropic
# ANTHROPIC_API_KEY=
# Rewording answers is OFF by default (it would send the answer text, with the patient's numbers, to the model). Turn on only with a local or trusted model:
# PRANA_LLM_REWORD=1
