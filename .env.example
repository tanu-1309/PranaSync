# copy to .env (never commit .env)
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/prana   # default: SQLite file data/prana.db

# ---- the language model. The portal uses ONE model family: NVIDIA Nemotron, through OpenRouter (see docs/LLM_SETUP.md).
PRANA_LLM=1
PRANA_LLM_URL=https://openrouter.ai/api/v1
PRANA_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
PRANA_LLM_KEY=
PRANA_LLM_TIMEOUT=400
# the reranking model (also Nemotron); it only orders texts and writes nothing
PRANA_RERANK_KEY=
PRANA_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

# ---- MedGemma (a second, medical model, served separately; off unless enabled). See docs/MEDGEMMA.md.
# PRANA_MEDGEMMA_ENABLED=1
# PRANA_MEDGEMMA_URL=https://<your-endpoint>/v1      (https is required unless it is localhost)
# PRANA_MEDGEMMA_KEY=
# PRANA_MEDGEMMA_MODEL=google/medgemma-1.5-4b-it
# PRANA_MEDGEMMA_VERSION=1.5.0                       (optional label stored with each result)
# PRANA_MEDGEMMA_TIMEOUT=120
# PRANA_MEDGEMMA_SCALE_UP_TIMEOUT=300                (for a scale-to-zero endpoint)


# ---- which model answers which task (src/prana/ai/model_router.py)
# PRANA_PRIMARY_MODEL=nemotron          general tasks and the existing workflows
# PRANA_MEDICAL_MODEL=medgemma          medical tasks (use nemotron to serve them with the primary model)
# PRANA_MODEL_COMPARISON_ENABLED=false  true runs BOTH models side by side on approved test data (costs two calls)

# ---- medical knowledge base (src/prana/ai/knowledge.py). Starts empty; add approved documents with scripts/ingest_knowledge.py.
# Optional: an OpenAI-style embeddings endpoint turns keyword retrieval into hybrid (keyword + meaning). Only plain words, never numbers, are sent.
# PRANA_EMBED_URL=https://<endpoint>/v1
# PRANA_EMBED_KEY=
# PRANA_EMBED_MODEL=

# ---- medical AI workflows (src/prana/ai/medical_explain.py)
# PRANA_CLOUD_AI_PATIENTS=PC0159        patient ids whose facts may be sent to an external model (comma list, or * for all). Default: the practice record only.
# PRANA_MEDICAL_POSSIBLE_EXPLANATIONS=false   keep off until a clinician has reviewed the wording

# Worked examples from our own data in the insight prompt (0 = off). Measure first: python finetune/eval_prompting.py
PRANA_AI_SHOTS=0
